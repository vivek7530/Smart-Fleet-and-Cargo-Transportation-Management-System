# ---------------------------------------------------------------------------
# CargoEntry — environment configuration
# Copy this file to `.env.local` and adjust the values for your machine.
# ---------------------------------------------------------------------------

NODE_ENV=development

# Public URL of the app — used to build invitation links.
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database — a local MongoDB instance.
# The very same URI can be pasted into MongoDB Compass to browse the data.
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/cargoentry

# ---------------------------------------------------------------------------
# Authentication
# JWT_SECRET must be a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_SECRET=replace-me-with-a-long-random-secret-value
JWT_EXPIRES_IN=7d
COOKIE_NAME=cargoentry_token
# Set to true only when the app is served over HTTPS.
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Initial administrator — created automatically on the first seed run
# if no ADMIN user exists yet.
# ---------------------------------------------------------------------------
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# ---------------------------------------------------------------------------
# Invitations
# ---------------------------------------------------------------------------
INVITATION_EXPIRES_HOURS=72

# ---------------------------------------------------------------------------
# Rate limiting — brute-force protection only.
#
# Only FAILED attempts are counted, so signing in successfully, inviting
# colleagues or changing your own password never consumes budget. A legitimate
# user cannot be locked out.
#
# RATE_LIMIT_DRIVER: 'memory' for a single instance, 'mongo' to share the window
# across replicas using the database you already run (no extra services).
# ---------------------------------------------------------------------------
RATE_LIMIT_DRIVER=memory
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_FAILURES=50
